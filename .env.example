# API key de OpenAI, usada por el Price Service (ETAPA 4). Nunca hardcodear.
OPENAI_API_KEY=

# Modelo usado para la búsqueda de precios vía Responses API + web_search.
# gpt-5-mini es el recomendado: soporta web_search y structured outputs, y es
# barato (el costo dominante es la tarifa fija de Web Search, no los tokens).
# Ver ARCHITECTURE.md sección 9 para el detalle de costos.
OPENAI_PRICE_MODEL=gpt-5-mini

# Máximo de llamadas de búsqueda/apertura de página que el modelo puede hacer
# por carta. Controla costo y latencia; observamos 1-7 llamadas según qué tan
# fácil sea encontrar la carta.
OPENAI_PRICE_MAX_TOOL_CALLS=5

# Cuántas cartas se actualizan en paralelo en POST /api/prices/update-all.
# Conservador a propósito para no disparar demasiadas búsquedas Web Search
# simultáneas (costo + rate limits de OpenAI).
PRICE_UPDATE_CONCURRENCY=2

# Opcional. pokemontcg.io funciona sin API key, pero con límites de tasa bajos
# (observamos errores 500 intermitentes en pruebas rápidas sin key).
# Registrar una gratis en https://dev.pokemontcg.io para mayor estabilidad.
POKEMON_TCG_IO_API_KEY=

# Opcional: si se omite, se usa data/pokemon_collection.db en la raíz del proyecto
# (ruta calculada automáticamente, funciona sin importar desde dónde se ejecute uvicorn).
# Descomentar solo si se quiere apuntar a otra ubicación o motor (ej. PostgreSQL a futuro).
# DATABASE_URL=sqlite:////ruta/absoluta/a/pokemon_collection.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
